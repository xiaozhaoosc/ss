PROJECT_NAME=small-steps
TZ=Asia/Shanghai
# 国内镜像加速前缀 (如 docker.m.daocloud.io/)，留空则用官方源
# DOCKER_IMAGE_PREFIX=registry.cn-shanghai.aliyuncs.com/ken_projects/
# DOCKER_IMAGE_PREFIX=docker.m.daocloud.io/
DOCKER_IMAGE_PREFIX=registry.cn-shanghai.aliyuncs.com/ken_projects/

# ==================================
# 密码与账号 (生产环境请修改!)
# ==================================
POSTGRES_USER=smallsteps
POSTGRES_PASSWORD=ui123456789~
POSTGRES_DB=smallsteps_db

REDIS_PASSWORD=ui123456789~

RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin

EMQX_USER=admin
EMQX_PASSWORD=public

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=ui123456789~

#  n8n 配置 ---
N8N_DB_NAME=n8n
N8N_USER=admin
N8N_PASSWORD=ui123456789~
N8N_BASIC_AUTH_ACTIVE=true

# ==================================
# 服务端口定义
# ==================================
PORT_NGINX=8043
PORT_EMQX_TCP=1883
PORT_EMQX_WS=8083
PORT_EMQX_DASHBOARD=18083
PORT_MINIO_API=9000
PORT_MINIO_CONSOLE=9001
PORT_N8N=5678  # n8n 面板端口